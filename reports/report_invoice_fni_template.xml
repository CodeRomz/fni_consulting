<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <template id="report_invoice_fni">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="fni_consulting.report_invoice_fni_document"/>
                </t>
            </t>
        </template>

        <template id="report_invoice_fni_document">

            <t t-set="lang" t-value="o.partner_id.lang or o.company_id.partner_id.lang"/>

            <t t-call="web.external_layout" t-lang="lang">
                <div class="page">
                    <!--CUSTOMER BLOCK-->
                    <div class="row mb-4">
                        <div class="col-6">
                            <span t-field="o.partner_id.name"/>
                            <br/>
                            <span t-field="o.partner_id"
                                  t-options='{"widget": "contact",
                                              "fields": ["address"],
                                              "no_marker": True}'/>
                        </div>
                        <div class="col-6 text-right">
                            <t t-if="o.partner_shipping_id and o.partner_shipping_id != o.partner_id">
                                <strong>Ship To:</strong>
                                <br/>
                                <span t-field="o.partner_shipping_id.name"/>
                                <br/>
                                <span t-field="o.partner_shipping_id"
                                      t-options='{"widget": "contact",
                                                  "fields": ["address"],
                                                  "no_marker": True}'/>
                            </t>
                        </div>
                    </div>
                    <!--INVOICE HEADER-->
                    <div class="row mb-4">
                        <h3>
                            TAX Invoice
                            <span t-field="o.name"/>
                        </h3>
                    </div>

                    <div class="row mb-3">
                        <div class="col-3 text-right">
                            <strong>Invoice Date:</strong>
                            <br/>
                            <span t-field="o.invoice_date"/>
                        </div>
                        <div class="col-3 text-right">
                            <strong>Due Date:</strong>
                            <br/>
                            <span t-field="o.invoice_date_due"/>
                        </div>
                        <div class="col-6 text-right">
                            <strong>Reference:</strong>
                            <br/>
                            <span t-field="o.payment_reference"/>
                        </div>
                    </div>

                    <!-- INVOICE LINES TABLE -->
                    <table class="table table-sm o_main_table">
                        <thead>
                            <tr>
                                <th>Description</th>
                                <th class="text-right">Project/Dept</th>
                                <th class="text-right">Quantity</th>
                                <th class="text-right">Unit Price</th>
                                <th class="text-right">Vat</th>
                                <th class="text-right">Vat Amount</th>
                                <th class="text-right">Ammount</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- invoice_line_ids: account.move.line -->
                            <t t-foreach="o.invoice_line_ids" t-as="line">
                                <tr>
                                    <td>
                                        <span t-field="line.name"/>
                                        <t t-if="line.product_id">
                                            <br/>
                                            <span class="text-muted">
                                                <t t-esc="line.product_id.default_code or ''"/>
                                            </span>
                                        </t>
                                    </td>

                                    <!-- ANALYTIC DISTRIBUTION COLUMN -->
                                    <td class="text-right">
                                        <t t-if="line.analytic_distribution">
                                            <t t-set="distribution" t-value="line.analytic_distribution or {}"/>
                                            <t t-foreach="distribution.items()" t-as="item">
                                                <t t-set="key_str" t-value="str(item[0])"/>
                                                <t t-set="key_parts" t-value="[p.strip() for p in key_str.split(',')]"/>
                                                <t t-foreach="key_parts" t-as="key_part">
                                                    <t t-if="key_part and key_part.isdigit()">
                                                        <t t-set="analytic_account"
                                                           t-value="env['account.analytic.account'].browse(int(key_part))"/>
                                                        <t t-if="analytic_account">
                                                            <span t-esc="analytic_account.name"/>
                                                            <!--(<span t-esc="item[1]"/>%)-->
                                                            <br/>
                                                        </t>
                                                    </t>
                                                </t>
                                            </t>
                                        </t>
                                    </td>

                                    <td class="text-right">
                                        <span t-field="line.quantity"/>
                                        <t t-if="line.product_uom_id">
                                            <span t-field="line.product_uom_id.name"/>
                                        </t>
                                    </td>
                                    <td class="text-right">
                                        <span t-field="line.price_unit"
                                              t-options='{"widget": "monetary",
                                                          "display_currency": o.currency_id}'/>
                                    </td>
                                    <td class="text-right">
                                        <!-- Show tax names in a compact way -->
                                        <t t-foreach="line.tax_ids" t-as="tax">
                                            <span t-esc="tax.name"/>
                                            <br/>
                                        </t>
                                    </td>

                                    <td class="text-right">
                                        <t t-set="vat_amount" t-value="line.price_total - line.price_subtotal"/>
                                        <span t-esc="'%s %s' % ( o.currency_id.symbol or '', '{0:,.2f}'.format(vat_amount) )"/>
                                    </td>

                                    <td class="text-right">
                                        <span t-field="line.price_subtotal"
                                              t-options='{"widget": "monetary",
                                                          "display_currency": o.currency_id}'/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>

                    <!-- TOTALS / TAX SUMMARY -->
                    <div class="row mt-3">
                        <div class="col-6">
                            <!-- Optional notes / terms -->
                            <t t-if="o.narration">
                                <strong>Notes</strong>
                                <p t-field="o.narration"/>
                            </t>
                        </div>

                        <div class="col-6">
                            <table class="table table-sm">
                                <tbody>
                                    <tr>
                                        <td class="text-right">
                                            <strong>Untaxed Amount</strong>
                                        </td>
                                        <td class="text-right">
                                            <span t-field="o.amount_untaxed"
                                                  t-options='{"widget": "monetary",
                                                              "display_currency": o.currency_id}'/>
                                        </td>
                                    </tr>
                                    <tr t-if="o.amount_tax">
                                        <td class="text-right">
                                            <strong>Taxes</strong>
                                        </td>
                                        <td class="text-right">
                                            <span t-field="o.amount_tax"
                                                  t-options='{"widget": "monetary",
                                                              "display_currency": o.currency_id}'/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="text-right">
                                            <strong>Total</strong>
                                        </td>
                                        <td class="text-right">
                                            <span t-field="o.amount_total"
                                                  t-options='{"widget": "monetary",
                                                              "display_currency": o.currency_id}'/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- FOOTER AREA: PAYMENT TERMS, BANK INFO, ETC. -->
                    <div class="mt-3">

                        <!-- Payment terms -->
                        <t t-if="o.invoice_payment_term_id">
                            <p>
                                <strong>Payment Terms:</strong>
                                <span t-field="o.invoice_payment_term_id.name"/>
                            </p>
                        </t>

                        <!-- Bank details: prefer invoice's bank, fallback to company first bank -->
                        <t t-set="bank"
                           t-value="o.partner_bank_id or (o.company_id.bank_ids and o.company_id.bank_ids[0])"/>

                        <t t-if="bank">
                            <p>
                                <strong>Business Account Name :</strong>
                                <span t-esc="bank.acc_holder_name or o.company_id.partner_id.name"/>
                                <br/>
                                <strong>Bank Name :</strong>
                                <span t-esc="bank.bank_id and bank.bank_id.name or ''"/>
                                <br/>
                                <strong>Account Number :</strong>
                                <span t-esc="bank.acc_number or ''"/>
                                <br/>
                                <!-- If you store IBAN separately, replace acc_number with bank.iban -->
                                <strong>IBAN Number :</strong>
                                <span t-esc="bank.acc_number or ''"/>
                                <br/>
                                <strong>Swift Code :</strong>
                                <span t-esc="bank.bank_id and bank.bank_id.bic or ''"/>
                            </p>
                        </t>
                    </div>
                </div>
            </t>
        </template>

    </data>
</odoo>
