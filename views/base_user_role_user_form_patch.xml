<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="fni_view_users_form_user_roles_multi_company" model="ir.ui.view">
        <field name="name">res.users.form.user_roles.multi_company.fni</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base_user_role.view_res_users_form_inherit"/>
        <field name="arch" type="xml">
            <xpath expr="//page[.//field[@name='role_line_ids']]/field[@name='role_line_ids']" position="before">
                <group string="Multi Companies" invisible="companies_count &lt;= 1" groups="base.group_erp_manager">
                    <field string="Allowed Companies" name="company_ids" widget="many2many_tags" options="{'no_create': True, 'color_field': 'color'}"/>
                    <field string="Default Company" name="company_id" context="{'user_preference': 0}"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
