<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Make sure this file is in __manifest__.py data[], after 'web' / 'account' -->
    <template id="external_layout_striped_fni_header"
              inherit_id="web.external_layout_striped"
              priority="60">

        <!-- 2.1 Move company address block to the right -->
        <xpath expr="//div[contains(@class, 'company_address')]" position="attributes">
            <!-- Replace the original classes (float-left company_address) -->
            <attribute name="class">
                company_address float-right text-end fni-header-company-address
            </attribute>
        </xpath>

        <!-- 2.2 Add Tax ID under the address (using company.vat) -->
        <xpath expr="//div[contains(@class, 'company_address')]" position="inside">
            <br/>
            <t t-if="company.vat">
                <span t-esc="company.country_id.vat_label or 'Tax ID'"/>:
                <span t-field="company.vat"/>
            </t>
        </xpath>

    </template>
</odoo>
