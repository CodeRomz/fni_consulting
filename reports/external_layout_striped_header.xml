<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <template id="external_layout_striped_fni_header"
                  name="FNI External Layout Striped"
                  inherit_id="web.external_layout_striped">

            <!--
                Odoo 18.0 CE:
                - Header container: <div t-attf-class="o_company_#{company.id}_layout header">
                - Company block: <div class=" w-50 ms-3" name="company_address">
                We hook that "company_address" div and only change its classes/styles.
            -->
            <xpath expr="//div[@name='company_address']" position="attributes">
                <!-- Align to the right & keep Bootstrap 5 convention -->
                <attribute name="class"
                           add="fni-header-company-address"
                           separator=" "/>
            </xpath>

        </template>

    </data>
</odoo>
