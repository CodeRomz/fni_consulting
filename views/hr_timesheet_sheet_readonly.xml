<odoo>
  <data>
    <record id="hr_timesheet_sheet_form_readonly_notebook" model="ir.ui.view">
      <field name="name">hr.timesheet.sheet.form.readonly.notebook</field>
      <field name="model">hr_timesheet.sheet</field>
      <field name="inherit_id" ref="hr_timesheet_sheet.hr_timesheet_sheet_form"/>
      <field name="arch" type="xml">
        <!-- 1. Make all fields on every page of the notebook read-only -->
        <xpath expr="//notebook//field" position="attributes">
          <attribute name="readonly">True</attribute>
        </xpath>

        <!-- 2. Remove inline editing and creation/deletion on every tree inside the notebook -->
        <xpath expr="//notebook//tree" position="attributes">
          <!-- disable the Add (+) and Delete icons -->
          <attribute name="create">false</attribute>
          <attribute name="delete">false</attribute>
          <!-- disable opening the inline editor; without edit=true Odoo ignores 'editable':contentReference[oaicite:4]{index=4} -->
          <attribute name="edit">false</attribute>
          <!-- optionally remove the editable attribute altogether by setting it empty -->
          <attribute name="editable"></attribute>
        </xpath>

        <!-- 3. Make one2many fields themselves read-only and hide quick-create/edit options -->
        <xpath expr="//notebook//field" position="attributes">
          <attribute name="options">{'no_create': True, 'no_create_edit': True}</attribute>
        </xpath>

        <!-- 4. Hide groups that contain edit-only controls (e.g. “Add new line” buttons) -->
        <xpath expr="//notebook//group[contains(@class, 'oe_edit_only')]" position="attributes">
          <attribute name="invisible">True</attribute>
        </xpath>
      </field>
    </record>
  </data>
</odoo>
