<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_fni_timesheet_sheet_reminder" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.fni.timesheet.sheet.reminder</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr_timesheet.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='hr_timesheet']//block[setting[@id='reminder_allow']]" position="after">
                <block title="Timesheet Sheet Reminders" name="fni_timesheet_sheet_reminders">
                    <setting id="timesheet_sheet_reminder_enabled" company_dependent="1"
                             help="Enable periodic reminder emails for employees who have not submitted their timesheet sheet.">
                        <field name="timesheet_sheet_reminder_enabled"/>
                    </setting>
                    <setting id="timesheet_sheet_deadline_weekday" company_dependent="1"
                             help="Weekday used as the submission deadline for each timesheet sheet. The system uses the next occurrence after the sheet end date.">
                        <field name="timesheet_sheet_deadline_weekday"/>
                    </setting>
                    <setting id="timesheet_sheet_reminder_days_info" company_dependent="1"
                             help="Send an informational reminder this many days before the deadline.">
                        <field name="timesheet_sheet_reminder_days_info"/>
                    </setting>
                    <setting id="timesheet_sheet_reminder_days_warning" company_dependent="1"
                             help="Send a warning reminder this many days before the deadline.">
                        <field name="timesheet_sheet_reminder_days_warning"/>
                    </setting>
                    <setting id="timesheet_sheet_reminder_days_danger" company_dependent="1"
                             help="Send the final reminder this many days before the deadline (0 means on the deadline day).">
                        <field name="timesheet_sheet_reminder_days_danger"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
