<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- Layout override for FNI – footer only -->
        <template id="external_layout_striped_fni_footer"
                  inherit_id="web.external_layout_striped"
                  priority="50">

            <!-- Replace the default footer container of the striped layout -->
            <xpath expr="//div[contains(@t-attf-class, 'footer') or contains(@t-att-class, 'footer') or contains(@class, 'footer')]"
                   position="replace">

                <!-- Custom footer without the native striped footer lines -->
                <div t-attf-class="o_company_#{company.id}_layout footer">
                    <div class="row mt8">
                        <div class="col-12 text-center" style="font-size: 13px;">
                            <t t-if="report_type == 'pdf'">
                                <div class="fni-margin-border"></div>
                                <span class="text-muted">
                                    Page:
                                    <span class="page"/>
                                    of
                                    <span class="topage"/>
                                </span>
                            </t>
                        </div>
                    </div>
                </div>
            </xpath>

        </template>

    </data>
</odoo>
