<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- FNI custom header for the Striped layout (Odoo 18.0) -->
        <template id="external_layout_striped_fni_header"
                  name="FNI External Layout Striped"
                  inherit_id="web.external_layout_striped">

            <!--
                Odoo 18.0: header container for external layouts is
                the div with t-attf-class containing 'header o_company_'.
                We replace that whole block, so we no longer depend on
                inner structure that changed between 17.0 and 18.0.
            -->
            <xpath expr="//div[contains(@t-attf-class, 'header o_company_')]"
                   position="replace">

                <div t-attf-class="header o_company_#{company.id}_layout"
                     t-att-style="report_header_style">

                    <!-- Keep the striped header background so core SCSS still applies -->
                    <div class="o_background_header">
                        <div class="row align-items-start">

                            <!-- Logo / left side -->
                            <div class="col-6">
                                <img t-if="company.logo"
                                     class="o_company_logo_small"
                                     t-att-src="image_data_uri(company.logo)"
                                     alt="Logo"/>
                            </div>

                            <!-- Company address + VAT / right side -->
                            <div class="col-6 text-right fni-header-company-address"
                                 style="padding-left: 500px;">
                                <!-- Company name -->
                                <t t-if="company.name">
                                    <h3 class="mt-0">
                                        <t t-esc="company.name"/>
                                    </h3>
                                </t>

                                <!-- Company address (contact widget, 18-style) -->
                                <t t-if="company.partner_id">
                                    <div t-field="company.partner_id"
                                         t-options='{
                                             "widget": "contact",
                                             "fields": ["address"],
                                             "no_marker": true
                                         }'/>
                                </t>

                                <!-- FNI VAT line (migrated from your 17.0 version) -->
                                <t t-if="company.vat or company.partner_id.vat">
                                    <div>
                                        <span t-esc="company.country_id.vat_label or 'VAT'"/>:
                                        <span t-esc="company.vat or company.partner_id.vat"/>
                                    </div>
                                </t>
                            </div>

                        </div>
                    </div>

                </div>

            </xpath>

        </template>

    </data>
</odoo>
