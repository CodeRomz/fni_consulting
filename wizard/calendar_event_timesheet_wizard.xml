<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_calendar_event_timesheet_wizard_form" model="ir.ui.view">
        <field name="name">calendar.event.timesheet.wizard.form</field>
        <field name="model">calendar.event.timesheet.wizard</field>
        <field name="arch" type="xml">
            <form string="Add Event to Timesheet">
                <field name="event_id" invisible="1"/>
                <group>
                    <field name="name"/>
                </group>
                <group>
                    <field name="date_time"/>
                    <field name="date_time_end"/>
                    <field name="unit_amount" readonly="1"/>
                </group>
                <group>
                    <field name="project_id"/>
                    <field name="task_id"/>
                </group>
                <footer>
                    <button name="action_create_timesheet" type="object" class="btn-primary" string="Create Timesheet"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_calendar_event_timesheet_wizard" model="ir.actions.act_window">
        <field name="name">Add Event to Timesheet</field>
        <field name="res_model">calendar.event.timesheet.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
