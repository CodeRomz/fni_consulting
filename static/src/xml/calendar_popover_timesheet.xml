<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="fni_consulting.CalendarCommonPopover.footer" t-inherit="web.CalendarCommonPopover.footer" t-inherit-mode="primary">
        <xpath expr="//t[@t-if='isEventDeletable']" position="after">
            <a href="#"
               class="btn btn-secondary o_cw_popover_add_timesheet ms-auto"
               t-on-click="onAddTimesheet">
                Add in Timesheet
            </a>
        </xpath>
    </t>
</templates>
