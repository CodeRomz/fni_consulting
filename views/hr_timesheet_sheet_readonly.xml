<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data>
    <record id="hr_timesheet_sheet_form_readonly_notebook" model="ir.ui.view">
      <field name="name">hr.timesheet.sheet.form.readonly.notebook</field>
      <field name="model">hr_timesheet.sheet</field>
      <field name="inherit_id" ref="hr_timesheet_sheet.hr_timesheet_sheet_form"/>
      <field name="arch" type="xml">
        <!-- Replace the one2many matrix on the Summary page -->
        <xpath expr="//field[@name='line_ids']" position="replace">
          <field name="line_ids"
                 nolabel="1"
                 widget="x2many_2d_matrix"
                 field_x_axis="value_x"
                 field_y_axis="value_y"
                 field_value="unit_amount"
                 x_axis_clickable="0"
                 y_axis_clickable="1"
                 readonly="True"
                 create="false"
                 edit="false"
                 delete="false">
            <tree limit="1000000">
              <field name="value_x" readonly="True"/>
              <field name="value_y" readonly="True"/>
              <field name="unit_amount" widget="float_time" readonly="True"/>
              <field name="sheet_id" readonly="True"/>
              <field name="date" readonly="True"/>
              <field name="project_id" readonly="True"/>
              <field name="task_id" readonly="True"/>
              <field name="company_id" groups="base.group_multi_company" readonly="True"/>
              <field name="employee_id" readonly="True"/>
              <field name="new_line_id" invisible="1" readonly="True"/>
            </tree>
          </field>
        </xpath>

        <!-- Hide the "Add new line" group (edit-only controls) -->
        <xpath expr="//group[contains(@class, 'oe_edit_only')]" position="attributes">
          <attribute name="invisible">True</attribute>
        </xpath>

        <!-- Replace the timesheet_ids one2many on the Details page -->
        <xpath expr="//field[@name='timesheet_ids']" position="replace">
          <field name="timesheet_ids"
                 nolabel="1"
                 context="{'user_id': user_id}"
                 readonly="True"
                 create="false"
                 edit="false"
                 delete="false">
            <tree>
              <field name="date" readonly="True"/>
              <field name="project_id" required="1" readonly="True"/>
              <field name="task_id"
                     domain="[('project_id', '=', project_id)]"
                     context="{'default_project_id': project_id}"
                     readonly="True"/>
              <field name="name" readonly="True"/>
              <field name="unit_amount" widget="float_time" string="Hours" sum="Hours" readonly="True"/>
              <field name="user_id" invisible="1" readonly="True"/>
            </tree>
            <form string="Timesheet Activities"
                  create="false"
                  edit="false"
                  delete="false">
              <group>
                <field name="date" readonly="True"/>
                <field name="name" readonly="True"/>
                <field name="project_id" required="1" readonly="True"/>
                <field name="task_id"
                       domain="[('project_id', '=', project_id)]"
                       context="{'default_project_id': project_id}"
                       readonly="True"/>
                <field name="unit_amount" widget="float_time" string="Hours" readonly="True"/>
                <field name="user_id" invisible="1"/>
              </group>
            </form>
          </field>
        </xpath>
      </field>
    </record>
  </data>
</odoo>
