<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="fni_A4_portrait" model="report.paperformat">
            <field name="name">FNI A4 Portrait</field>
            <field name="format">A4</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">10</field>
            <field name="margin_bottom">10</field>
            <field name="margin_left">10</field>
            <field name="margin_right">10</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">2</field>
            <field name="dpi">90</field>
        </record>

        <record id="hr_emp_ack_report" model="ir.actions.report">
            <field name="name">HR Employee Acknowledgement</field>
            <field name="model">survey.user_input</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">fni_consulting.hr_emp_ack_report_view</field>
            <field name="print_report_name">'Acknowledgement - %s - %s' % (object.partner_id.name, object.create_date.strftime('%d-%b-%Y'))</field>
            <field name="paperformat_id" ref="fni_A4_portrait"/>
            <field name="binding_model_id" ref="survey.model_survey_user_input"/>
            <field name="binding_type">report</field>
        </record>
    </data>
</odoo>