<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- FNI custom header for STRIPED layout in Odoo 18.0 -->
        <template id="external_layout_striped_fni_header"
                  name="FNI External Layout Striped"
                  inherit_id="web.external_layout_striped">

            <!-- Target the header container div defined in the base template.
                 We locate the <div> element whose @t-attf-class attribute
                 contains 'header'.  This is more robust than selecting the
                 first div in the template, ensuring our override applies even
                 if the base template structure changes. -->
            <xpath expr="//div[@t-attf-class and contains(@t-attf-class, 'header')]" position="replace">
                <!--
                    Override the first <div> in the base template (the header container)
                    and add a bottom border directly on the header element.  A separate
                    self-closing or empty <div> will not reliably render a border in
                    QWeb/PDF outputs.  Instead, apply a bottom border via inline
                    style on the header itself.  The margin-bottom class (mb-5) is
                    retained to preserve spacing between the header and the document
                    body.  This approach ensures the border is visible both in the
                    HTML preview and in the generated PDF.  rgba(110, 110, 110, 0.20)
                -->
                <div t-attf-class="o_company_#{company.id}_layout header mb-5">
                    <div class="container">
                        <div class="row" style="border-bottom: 1px solid black;">
                            <!-- LEFT: Logo-->
                            <div class="col-8">
                                <img t-if="company.logo"
                                     class="o_company_logo_big"
                                     t-att-src="image_data_uri(company.logo)"
                                     alt="Logo"/>
                            </div>

                            <!-- RIGHT: Company address + VAT, FNI-style -->
                            <div class="col-4" name="company_address">
                                <ul class="list-unstyled" name="company_address_list">

                                    <!-- Address / company details, same logic as core -->
                                    <li t-if="company.is_company_details_empty">
                                        <span t-field="company.partner_id"
                                              t-options='{
                                              "widget": "contact",
                                              "fields": ["address", "name"],
                                              "no_marker": true
                                          }'/>
                                    </li>
                                    <li t-else="">
                                        <span t-field="company.company_details"/>
                                    </li>

                                    <!-- VAT line: explicit, 17.0-style behaviour -->
                                    <li t-if="company.vat or company.partner_id.vat">
                                        <span t-esc="company.country_id.vat_label or 'VAT'"/>:
                                        <span t-esc="company.vat or company.partner_id.vat"/>
                                    </li>

                                </ul>
                            </div>

                        </div>
                    </div>
                </div>
            </xpath>

        </template>

    </data>
</odoo>
