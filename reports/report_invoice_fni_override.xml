<!-- views/report_invoice_fni_override.xml -->
<odoo>
    <!-- Override the base invoice PDF body -->
    <template id="account.report_invoice_document" inherit_id="account.report_invoice_document">
        <xpath expr="//t[@t-call]" position="replace">
            <!-- Call your VAT-aware wrapper instead of the standard document -->
            <t t-call="fni_consulting.report_invoice_fni_auto"/>
        </xpath>
    </template>

    <!-- Override the payment/no-payment variant injected into the Print menu -->
    <template id="account.report_invoice_document_without_payment"
              inherit_id="account.report_invoice_document_without_payment">
        <xpath expr="//t[@t-call]" position="replace">
            <t t-call="fni_consulting.report_invoice_fni_auto"/>
        </xpath>
    </template>

    <!-- Override the portal/preview template -->
    <template id="account.report_invoice_document_preview" inherit_id="account.report_invoice_document_preview">
        <xpath expr="//t[@t-call]" position="replace">
            <t t-call="fni_consulting.report_invoice_fni_auto"/>
        </xpath>
    </template>
</odoo>
