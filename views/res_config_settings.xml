<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="fni_res_config_settings_view_form_invoicing" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.fni.invoice</field>
        <field name="model">res.config.settings</field>
        <!-- Inherit the base settings form -->
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="priority" eval="30"/>
        <field name="arch" type="xml">
            <!-- Target the Invoicing app by its name ('account') -->
            <xpath expr="//app[@name='account']" position="inside">
                <!-- Add our FNI block inside the existing Invoicing section -->
                <block title="FNI Invoice Configuration"
                       name="fni_invoice_configuration"
                       help="Configure the default FNI invoice report used for printing, sending and portal downloads."
                       groups="account.group_account_manager">
                    <setting string="Default FNI Invoice Report"
                             help="Select which FNI invoice report (VAT/Non‑VAT wrapper) should be used by default.">
                        <div class="content-group mt16">
                            <field name="fni_default_invoice_report_id"
                                   options="{'no_create_edit': True}"/>
                            <div class="text-muted">
                                This report will be used for printing, sending and portal downloads when set.
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
