<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- FNI – Striped layout: custom header -->
        <template id="external_layout_striped_fni_header"
                  name="FNI External Layout Striped Header"
                  inherit_id="web.external_layout_striped"
                  priority="60">

            <xpath expr="//div[hasclass('o_background_header')]"
                   position="replace">

                <div class="o_background_header">
                    <div class="row">

                        <!-- LEFT: logo -->
                        <div class="col-6">
                            <img t-if="company.logo"
                                 t-att-src="image_data_uri(company.logo)"
                                 style="max-width:260px; max-height:89px;"
                                 alt="Logo"/>
                        </div>

                        <!-- RIGHT: tagline + address + Tax ID -->
                        <div class="col-6 text-right fni-header-company-address">

                            <!-- Company tagline (Document Layout → Tagline) -->
                            <div t-if="company.report_header" class="mb2">
                                <span t-field="company.report_header"/>
                            </div>

                            <!-- Company address / details -->
                            <div class="mb1">
                                <!-- Prefer company.company_details if filled -->
                                <t t-if="company.company_details">
                                    <t t-esc="company.company_details"/>
                                </t>
                                <t t-else="">
                                    <div t-field="company.partner_id"
                                         t-options="{
                                             'widget': 'contact',
                                             'fields': ['address', 'name'],
                                             'no_marker': True
                                         }"/>
                                </t>
                            </div>

                            <!-- Tax ID / VAT line -->
                            <t t-if="company.vat or company.partner_id.vat">
                                <div>
                                    <span t-esc="company.country_id.vat_label or 'Tax ID'"/>:
                                    <span t-esc="company.vat or company.partner_id.vat"/>
                                </div>
                            </t>

                        </div>
                    </div>
                </div>

            </xpath>

        </template>

    </data>
</odoo>
