<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <template id="external_layout_striped_fni_header"
                  name="FNI External Layout Striped"
                  inherit_id="web.external_layout_striped">

            <!-- Replace the first div = header of external_layout_striped -->
            <xpath expr="//div[1]" position="replace">
                <div t-attf-class="header o_company_#{company.id}_layout">
                    <div class="row mb-2">
                        <!-- Logo -->
                        <div class="col-6 mb-2">
                            <img t-if="company.logo"
                                 t-att-src="image_data_uri(company.logo)"
                                 style="max-height: 65px; max-width: 100%;"
                                 alt="Logo"/>
                        </div>

                        <!-- Company address + VAT -->
                        <div class="col-6 mb-2 fni-header-company-address">
                            <div>
                                <span t-field="company.partner_id"
                                      t-options="{
                                          'widget': 'contact',
                                          'fields': ['address', 'name'],
                                          'no_marker': True
                                      }"/>
                            </div>

                            <!-- VAT line (company VAT or partner VAT) -->
                            <t t-if="company.vat or company.partner_id.vat">
                                <span t-esc="company.country_id.vat_label or 'VAT'"/>:
                                <span t-esc="company.vat or company.partner_id.vat"/>
                            </t>
                        </div>
                    </div>

                    <!-- Optional separator line if you want -->
                    <div class="row">
                        <div class="col-12">
                            <div style="border-bottom: 1px solid #000;"/>
                        </div>
                    </div>
                </div>
            </xpath>

        </template>

    </data>
</odoo>
