<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <template id="external_layout_striped_fni_header"
                  name="FNI External Layout Striped"
                  inherit_id="web.external_layout_striped">

            <!-- Add company VAT line after the company address block -->
            <xpath expr="//*[@t-field='company.partner_id']"
                   position="after">
                <t t-if="company.vat or company.partner_id.vat">
                    <span t-esc="company.country_id.vat_label or 'VAT'"/>:
                    <span t-esc="company.vat or company.partner_id.vat"/>
                </t>
            </xpath>

            <!-- Align the company address block -->
            <xpath expr="//*[@t-field='company.partner_id']/.."
                   position="attributes">
                <attribute name="class"
                           add="text-right fni-header-company-address"
                           separator=" "/>
                <attribute name="style"
                           add="padding-left: 500px;"
                           separator="; "/>
            </xpath>

        </template>

    </data>
</odoo>
