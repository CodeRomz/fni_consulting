<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!--
            MAIN REPORT TEMPLATE
            external id: fni_consulting.report_invoice_fni
            - used by ir.actions.report.report_name
            - docs: recordset of account.move (invoices) provided by Odoo
            - wraps content in web.html_container (standard report container)
        -->
        <template id="report_invoice_fni">
            <t t-call="web.html_container">
                <!-- docs: account.move records (invoices) -->
                <t t-foreach="docs" t-as="o">
                    <!-- per-invoice document rendering -->
                    <t t-call="fni_consulting.report_invoice_fni_document"/>
                </t>
            </t>
        </template>

        <!--
    DOCUMENT TEMPLATE
    external id: fni_consulting.report_invoice_fni_document

    Available key variables (Odoo report context):
      - docs: recordset of account.move (invoices)
      - o: current invoice from docs (see t-foreach above)
      - doc_ids: list of ids (optional, via _get_report_values)
      - doc_model: "account.move"
      - user: current res.users
      - res_company: company of current user
      - website, web_base_url, time, context_timestamp, ...

    Common fields used on account.move (o):
      - o.name              : Invoice number
      - o.invoice_date      : Invoice date
      - o.partner_id        : Customer (res.partner)
      - o.company_id        : Company (res.company)
      - o.invoice_line_ids  : One2many of lines (account.move.line)
      - o.tax_line_ids      : Tax line summary
      - o.currency_id       : Currency
      - o.amount_untaxed    : Untaxed amount
      - o.amount_tax        : Total tax
      - o.amount_total      : Grand total
-->
        <template id="report_invoice_fni_document">

            <!-- You can set language using partner or company -->
            <t t-set="lang" t-value="o.partner_id.lang or o.company_id.partner_id.lang"/>

            <!-- Standard header + footer wrapper -->
            <t t-call="web.external_layout" t-lang="lang">
                <div class="page">

                    <!-- HEADER ROW: COMPANY / INVOICE META -->
                    <div class="row mb-4">
                        <div class="col-6">
                            <h2>
                                <span t-field="o.company_id.partner_id.name"/>
                            </h2>
                            <div>
                                <!-- Company address block -->
                                <span t-field="o.company_id.partner_id"
                                      t-options='{"widget": "contact",
                                                  "fields": ["address"],
                                                  "no_marker": True}'/>
                            </div>
                        </div>

                        <div class="col-6 text-right">
                            <h3>FNI Invoice</h3>
                            <div>
                                <strong>Invoice #:</strong>
                                <span t-field="o.name"/>
                            </div>
                            <div>
                                <strong>Date:</strong>
                                <span t-field="o.invoice_date"/>
                            </div>
                            <div t-if="o.invoice_origin">
                                <strong>Source:</strong>
                                <span t-field="o.invoice_origin"/>
                            </div>
                        </div>
                    </div>

                    <!-- CUSTOMER BLOCK -->
                    <div class="row mb-4">
                        <div class="col-6">
                            <strong>Bill To:</strong>
                            <br/>
                            <span t-field="o.partner_id.name"/>
                            <br/>
                            <span t-field="o.partner_id"
                                  t-options='{"widget": "contact",
                                              "fields": ["address"],
                                              "no_marker": True}'/>
                        </div>
                        <div class="col-6 text-right">
                            <t t-if="o.partner_shipping_id and o.partner_shipping_id != o.partner_id">
                                <strong>Ship To:</strong>
                                <br/>
                                <span t-field="o.partner_shipping_id.name"/>
                                <br/>
                                <span t-field="o.partner_shipping_id"
                                      t-options='{"widget": "contact",
                                                  "fields": ["address"],
                                                  "no_marker": True}'/>
                            </t>
                        </div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-3 text-right" >
                                <strong>Invoice Date:</strong>
                                <span t-field="o.invoice_date"/>
                        </div>
                        <div class="col-3 text-right" >
                                <strong>Due Date:</strong>
                                <span t-field="o.invoice_date_due"/>
                        </div>
                        <div class="col-3 text-right" >
                                <strong>HODLER:</strong>

                        </div>
                        <div class="col-3 text-right" >
                                <strong>HOLDER:</strong>

                        </div>
                    </div>



                    <!-- INVOICE LINES TABLE -->
                    <table class="table table-sm o_main_table">
                        <thead>
                            <tr>
                                <th>Description</th>
                                <th class="text-right">Analytic Distribution</th>
                                <th class="text-right">Quantity</th>
                                <th class="text-right">Unit Price</th>
                                <th class="text-right">Taxes</th>
                                <th class="text-right">Subtotal</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- invoice_line_ids: account.move.line -->
                            <t t-foreach="o.invoice_line_ids" t-as="line">
                                <tr>
                                    <td>
                                        <span t-field="line.name"/>
                                        <t t-if="line.product_id">
                                            <br/>
                                            <span class="text-muted">
                                                <t t-esc="line.product_id.default_code or ''"/>
                                            </span>
                                        </t>
                                    </td>
                                    <td class="text-right">
                                        <span t-field="line.analytic_distribution"/>
                                        <t t-if="line.analytic_distribution_id">
                                            <span t-field="line.analytic_distribution.name"/>
                                        </t>
                                    </td>
                                    <td class="text-right">
                                        <span t-field="line.quantity"/>
                                        <t t-if="line.product_uom_id">
                                            <span t-field="line.product_uom_id.name"/>
                                        </t>
                                    </td>
                                    <td class="text-right">
                                        <span t-field="line.price_unit"
                                              t-options='{"widget": "monetary",
                                                          "display_currency": o.currency_id}'/>
                                    </td>
                                    <td class="text-right">
                                        <!-- Show tax names in a compact way -->
                                        <t t-foreach="line.tax_ids" t-as="tax">
                                            <span t-esc="tax.name"/>
                                            <br/>
                                        </t>
                                    </td>
                                    <td class="text-right">
                                        <span t-field="line.price_subtotal"
                                              t-options='{"widget": "monetary",
                                                          "display_currency": o.currency_id}'/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>

                    <!-- TOTALS / TAX SUMMARY -->
                    <div class="row mt-4">
                        <div class="col-6">
                            <!-- Optional notes / terms; you can adapt field -->
                            <t t-if="o.narration">
                                <strong>Notes</strong>
                                <p t-field="o.narration"/>
                            </t>
                        </div>

                        <div class="col-6">
                            <table class="table table-sm">
                                <tbody>
                                    <tr>
                                        <td class="text-right">
                                            <strong>Untaxed Amount</strong>
                                        </td>
                                        <td class="text-right">
                                            <span t-field="o.amount_untaxed"
                                                  t-options='{"widget": "monetary",
                                                              "display_currency": o.currency_id}'/>
                                        </td>
                                    </tr>
                                    <tr t-if="o.amount_tax">
                                        <td class="text-right">
                                            <strong>Taxes</strong>
                                        </td>
                                        <td class="text-right">
                                            <span t-field="o.amount_tax"
                                                  t-options='{"widget": "monetary",
                                                              "display_currency": o.currency_id}'/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="text-right">
                                            <strong>Total</strong>
                                        </td>
                                        <td class="text-right">
                                            <span t-field="o.amount_total"
                                                  t-options='{"widget": "monetary",
                                                              "display_currency": o.currency_id}'/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- FOOTER AREA: PAYMENT TERMS, BANK INFO, ETC. -->
                    <div class="mt-3">
                        <t t-if="o.invoice_payment_term_id">
                            <p>
                                <strong>Payment Terms:</strong>
                                <span t-field="o.invoice_payment_term_id.name"/>
                            </p>
                        </t>

                        <t t-if="o.company_id.bank_ids">
                            <p>
                                <strong>Bank Account:</strong>
                                <t t-foreach="o.company_id.bank_ids" t-as="bank">
                                    <br/>
                                    <t t-esc="bank.acc_number or ''"/>
                                    <t t-if="bank.bank_id">
                                        (<t t-esc="bank.bank_id.name"/>)
                                    </t>
                                </t>
                            </p>
                        </t>
                    </div>

                </div>
            </t>
        </template>

    </data>
</odoo>
