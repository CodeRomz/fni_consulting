<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!--
            ir.actions.report
            - external id: fni_account_invoice_format.action_report_fni_invoice
            - model: account.move (invoices)
            - binding_model_id: account.model_account_move
            - binding_type: "report" => shows under Print menu
            - report_name/report_file must match the QWeb template id
              with module prefix: fni_consulting.report_vat_invoice_fni
        -->
        <record id="action_report_fni_vat_invoice" model="ir.actions.report">
            <!-- Label in the Print dropdown -->
            <field name="name">Tax Invoice (FNI)</field>

            <!-- Technical model name: account.move (Odoo 17 invoices) -->
            <field name="model">account.move</field>

            <!-- QWeb PDF report -->
            <field name="report_type">qweb-pdf</field>

            <!-- QWeb template external id (module.template_id) -->
            <field name="report_name">fni_consulting.report_vat_invoice_fni</field>
            <field name="report_file">fni_consulting.report_vat_invoice_fni</field>

            <!-- Bind to invoice form Print menu -->
            <field name="binding_model_id" ref="account.model_account_move"/>
            <field name="binding_type">report</field>
            <field name="paperformat_id" ref="fni_A4_portrait"/>

            <!-- Optional: control the generated PDF file name -->
            <!-- 'object' here is the current account.move record -->
            <field name="print_report_name">
                (object.name or 'INV').replace('/', '_') + '_FNI'
            </field>
        </record>

        <record id="action_report_fni_invoice" model="ir.actions.report">
            <!-- Label in the Print dropdown -->
            <field name="name">Invoice (FNI)</field>

            <!-- Technical model name: account.move (Odoo 17 invoices) -->
            <field name="model">account.move</field>

            <!-- QWeb PDF report -->
            <field name="report_type">qweb-pdf</field>

            <!-- QWeb template external id (module.template_id) -->
            <field name="report_name">fni_consulting.report_invoice_fni</field>
            <field name="report_file">fni_consulting.report_invoice_fni</field>

            <!-- Bind to invoice form Print menu -->
            <field name="binding_model_id" ref="account.model_account_move"/>
            <field name="binding_type">report</field>
            <field name="paperformat_id" ref="fni_A4_portrait"/>

            <!-- Optional: control the generated PDF file name -->
            <!-- 'object' here is the current account.move record -->
            <field name="print_report_name">
                (object.name or 'INV').replace('/', '_') + '_FNI'
            </field>
        </record>

    </data>
</odoo>
