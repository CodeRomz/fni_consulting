<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="hr_timesheet_sheet_form_readonly_notebook" model="ir.ui.view">
            <field name="name">hr.timesheet.sheet.form.readonly.notebook</field>
            <field name="model">hr_timesheet.sheet</field>
            <field name="inherit_id" ref="hr_timesheet_sheet.hr_timesheet_sheet_form"/>
            <field name="arch" type="xml">
                <!-- Summary matrix (line_ids): disable adding/deleting lines, make columns read-only -->
                <xpath expr="//field[@name='line_ids']/tree" position="attributes">
                    <attribute name="create">false</attribute>
                    <attribute name="delete">false</attribute>
                </xpath>
                <xpath expr="//field[@name='line_ids']/tree//field" position="attributes">
                    <attribute name="readonly">True</attribute>
                </xpath>

                <!-- Hide the Add New Line group -->
                <xpath expr="//group[contains(@class,'oe_edit_only')]" position="attributes">
                    <attribute name="invisible">True</attribute>
                </xpath>

                <!-- Details one2many (timesheet_ids): disable create/delete in list view -->
                <xpath expr="//field[@name='timesheet_ids']/tree" position="attributes">
                    <attribute name="create">false</attribute>
                    <attribute name="delete">false</attribute>
                </xpath>
                <!-- Make every column read-only -->
                <xpath expr="//field[@name='timesheet_ids']/tree//field" position="attributes">
                    <attribute name="readonly">True</attribute>
                </xpath>

                <!-- Disable editing in the pop-up form and mark its fields read-only -->
                <xpath expr="//field[@name='timesheet_ids']/form" position="attributes">
                    <attribute name="create">false</attribute>
                    <attribute name="edit">false</attribute>
                    <attribute name="delete">false</attribute>
                </xpath>
                <xpath expr="//field[@name='timesheet_ids']/form//field" position="attributes">
                    <attribute name="readonly">True</attribute>
                </xpath>

                <!-- NEW: Prevent project_id from offering Create or Create & Edit -->
                <xpath expr="//field[@name='timesheet_ids']/tree//field[@name='project_id']" position="attributes">
                    <attribute name="options">{'no_create': True, 'no_create_edit': True}</attribute>
                </xpath>
                <xpath expr="//field[@name='timesheet_ids']/form//field[@name='project_id']" position="attributes">
                    <attribute name="options">{'no_create': True, 'no_create_edit': True}</attribute>
                </xpath>

                <!-- NEW: Prevent project_id from offering Create or Create & Edit -->
                <xpath expr="//field[@name='timesheet_ids']/tree//field[@name='task_id']" position="attributes">
                    <attribute name="options">{'no_create': True, 'no_create_edit': True}</attribute>
                </xpath>
                <xpath expr="//field[@name='timesheet_ids']/form//field[@name='task_id']" position="attributes">
                    <attribute name="options">{'no_create': True, 'no_create_edit': True}</attribute>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
