<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="action_report_fni_invoice" model="ir.actions.report">
            <field name="name">Invoice (FNI)</field>
            <field name="model">account.move</field>
            <field name="report_type">qweb-pdf</field>
            <field name="is_invoice_report">True</field>
            <!-- Use the wrapper template created above -->
            <field name="report_name">fni_consulting.report_invoice_fni_auto</field>
            <field name="report_file">fni_consulting.report_invoice_fni_auto</field>
            <field name="binding_model_id" ref="account.model_account_move"/>
            <field name="binding_type">report</field>
            <field name="paperformat_id" ref="fni_A4_portrait_inv"/>
            <field name="print_report_name">
                (object.name or 'INV').replace('/', '_') + '_FNI'
            </field>
        </record>


    </data>
</odoo>
